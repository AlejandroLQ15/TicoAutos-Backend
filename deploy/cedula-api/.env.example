# Puerto del sidecar (debe coincidir con el mapeo en Docker)
PORT=8787

# Origen compatible con gometa (misma forma de respuesta JSON).
# Sustituye por tu propio backend cuando tengas datos en local.
CEDULA_UPSTREAM_BASE=https://apis.gometa.org/cedulas

# Tiempo máximo de espera al upstream (ms)
CEDULA_UPSTREAM_TIMEOUT_MS=12000
