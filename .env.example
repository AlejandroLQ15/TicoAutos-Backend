# Copia este archivo como .env y completa los valores.
# No subas el .env a Git (debe estar en .gitignore).

# Obligatorio: clave para firmar y verificar tokens JWT (login).
JWT_SECRET=tu_clave_secreta_aqui

# Opcional: URI de MongoDB. Si no se define, se usa mongodb://127.0.0.1:27017/ticoautos
# MONGO_URI=mongodb://127.0.0.1:27017/ticoautos
# MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/ticoautos

# Opcional: puerto del servidor. Por defecto 3000.
# PORT=3000

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Obtener en https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
# URL a la que Google redirige tras autenticar (debe coincidir con la configurada en Google Cloud)
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# URL base del frontend (para las redirecciones post-OAuth)
FRONTEND_URL=http://127.0.0.1:5500

# ─── API de cédulas (padrón electoral) ───────────────────────────────────────
# Base URL sin la cédula al final, o plantilla con {cedula} o {numero}.
# Público (default): https://apis.gometa.org/cedulas
# En tu servidor: levanta el sidecar (ver deploy/cedula-api y docker-compose.cedula.yml)
#   docker compose -f docker-compose.cedula.yml up -d --build
#   CEDULA_API_URL=http://127.0.0.1:8787/cedulas
CEDULA_API_URL=https://apis.gometa.org/cedulas
# Tiempo máximo de espera al consultar CEDULA_API_URL (ms, default 12000)
# CEDULA_API_TIMEOUT_MS=12000

# ─── Mayoría de edad (registro y login con contraseña) ────────────────────────
# Años cumplidos mínimos según calendario America/Costa_Rica (default 18).
MIN_REGISTRATION_AGE=18

# ─── Sesión (solo para flujo OAuth transitorio) ───────────────────────────────
SESSION_SECRET=ticoautos_session_secret_aqui

# ─── SendGrid (verificación de correo electrónico) ────────────────────────────
# Sin estas variables el servidor solo “simula” el envío (ver consola). En producción
# configúralas para que los usuarios reciban el enlace de activación.
#
# 1) Cuenta en https://sendgrid.com y verifica un remitente:
#    Settings → Sender Authentication → “Single Sender” (rápido) o dominio (recomendado).
# 2) API Key: Settings → API Keys → “Create API Key” (permiso Mail Send es suficiente).
# 3) Copia la clave aquí y el correo verificado exactamente como en SendGrid.
#
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@tudominio.com
# Nombre que verá el usuario junto al remitente (opcional)
# SENDGRID_FROM_NAME=TicoAutos
# Respuestas a otro buzón (opcional)
# SENDGRID_REPLY_TO=soporte@tudominio.com
# URL del logo en el HTML del correo (opcional; hay un default si lo omites)
# SENDGRID_MAIL_LOGO_URL=https://tu-frontend.com/assets/TicoAutos_Logo.png
# true = modo sandbox de SendGrid (no entrega a buzones reales; solo pruebas en panel)
# SENDGRID_SANDBOX_MODE=false
# Tiempo de validez del enlace de activación en horas (default 24)
ACTIVATION_TOKEN_TTL_HOURS=24
# Tiempo mínimo entre solicitudes de reenvío del correo de activación (default 60)
ACTIVATION_RESEND_COOLDOWN_SECONDS=60

# ─── Twilio (autenticación de dos factores por SMS) ───────────────────────────
# Obtener en https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número Twilio en formato E.164 (ej: +15005550006 para sandbox, o tu número real)
TWILIO_FROM_NUMBER=+15005550006
# Tiempo de validez del código OTP en minutos (default 10)
MFA_CODE_TTL_MINUTES=10

# ─── OpenAI (moderación de mensajes del chat / inbox) ───────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Opcional (default gpt-4o-mini)
# OPENAI_CHAT_MODERATION_MODEL=gpt-4o-mini
